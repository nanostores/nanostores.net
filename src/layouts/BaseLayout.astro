---
import '../styles/global.css'
import FontPreloads from '../components/layout/FontPreloads.astro'
import ThemeProvider from '../components/layout/ThemeProvider.astro'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import Analytics from '../components/layout/Analytics.astro'
interface Props {
  title: string
  description: string
  noindex?: boolean
  // Other fonts the first screen needs.
  preload?: string[]
}
const { title, description, noindex = false, preload = [] } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeProvider />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <FontPreloads extra={preload} />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main
      id="main"
      data-pagefind-body
      data-pagefind-meta={`title:${title.replace(/ \| Nano Stores$/, '')}`}
    >
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
