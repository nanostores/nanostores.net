---
import '../../styles/search.css'
---

<site-search>
  <button
    class="search-trigger"
    type="button"
    disabled
    aria-label="Search"
    aria-keyshortcuts="Control+K"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </svg>
    <span class="search-label" aria-hidden="true">
      Search
    </span>
    <kbd class="search-shortcut" aria-hidden="true">
      <span class="search-shortcut-ctrl">Ctrl K</span>
      <span class="search-shortcut-meta">⌘ K</span>
    </kbd>
  </button>
  <dialog aria-label="Search">
    <div class="search-panel">
      <div class="search-heading">
        <h2>Search</h2>
        <button class="search-close" type="button" aria-label="Close search">
          Close
        </button>
      </div>
      {import.meta.env.DEV ? (
        <p>Search is available in the production preview.</p>
      ) : (
        <>
          <p class="search-status" role="status" hidden>
            Loading search…
          </p>
          <div id="site-search-results" />
        </>
      )}
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>('.search-trigger')!
      const close = this.querySelector<HTMLButtonElement>('.search-close')!
      const dialog = this.querySelector('dialog')!
      const status = this.querySelector<HTMLElement>('.search-status')
      let initialising: Promise<void> | undefined
      if (document.documentElement.dataset.platform === 'apple') {
        trigger.setAttribute('aria-keyshortcuts', 'Meta+K')
      }
      trigger.disabled = false
      const input = () => this.querySelector<HTMLInputElement>('input')
      const results = () => this.querySelectorAll('.pagefind-ui__result')
      let pending = -1
      const focusInput = () => {
        if (dialog.open) input()?.focus()
      }
      const initialise = () => {
        if (import.meta.env.DEV) return Promise.resolve()
        if (initialising) return initialising
        status!.hidden = false
        status!.textContent = 'Loading search…'
        initialising = (async () => {
          // @ts-expect-error Pagefind's default UI package does not declare types.
          const { PagefindUI } = await import('@pagefind/default-ui')
          new PagefindUI({
            element: '#site-search-results',
            bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`,
            baseUrl: import.meta.env.BASE_URL,
            showImages: false,
            showSubResults: true,
            translations: { placeholder: 'Search the site' },
            processResult: (result: {
              url: string
              sub_results: { url: string }[]
            }) => {
              for (const sub of result.sub_results) {
                if (sub.url === `${result.url}#_top`) sub.url = result.url
              }
              return result
            },
          })
          status!.hidden = true
          new MutationObserver(() => {
            const added = results()[pending]?.querySelector<HTMLElement>('a')
            if (added) {
              pending = -1
              added.focus()
            }
          }).observe(this.querySelector('#site-search-results')!, {
            childList: true,
            subtree: true,
          })
        })().catch(() => {
          initialising = undefined
          status!.textContent =
            'Search is unavailable. Close and reopen to try again.'
        })
        return initialising
      }
      const open = () => {
        // Search and the mobile menu should never compete for keyboard focus.
        document
          .querySelectorAll<HTMLElement>('[popover]:popover-open')
          .forEach((menu) => menu.hidePopover())
        dialog.showModal()
        requestAnimationFrame(focusInput)
        initialise().then(focusInput)
      }
      trigger.addEventListener('click', open)
      close.addEventListener('click', () => dialog.close())
      dialog.addEventListener('click', (event) => {
        const target = event.target as Element
        if (target === dialog || target.closest('a[href]')) dialog.close()
        if (target.closest('.pagefind-ui__search-clear')) input()?.focus()
      })
      dialog.addEventListener(
        'click',
        (event) => {
          if ((event.target as Element).closest('.pagefind-ui__button')) {
            pending = results().length
          }
        },
        true,
      )
      dialog.addEventListener('keydown', (event) => {
        const { key, isComposing, shiftKey, altKey, ctrlKey, metaKey } = event
        if (key !== 'ArrowDown' && key !== 'ArrowUp') return
        if (isComposing || shiftKey || altKey || ctrlKey || metaKey) return
        const items = [
          input(),
          ...this.querySelectorAll<HTMLElement>(
            '.pagefind-ui__result-link, .pagefind-ui__button',
          ),
        ]
        const index = items.indexOf(document.activeElement as HTMLElement)
        if (index === -1) return
        event.preventDefault()
        items[index + (key === 'ArrowDown' ? 1 : -1)]?.focus()
      })
      dialog.addEventListener('close', () => {
        pending = -1
        trigger.focus({ preventScroll: true })
      })
      const shortcut = (event: KeyboardEvent) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          !event.altKey &&
          event.key.toLowerCase() === 'k'
        ) {
          event.preventDefault()
          if (dialog.open) dialog.close()
          else open()
        }
      }
      window.addEventListener('keydown', shortcut)
      this.stopListening = () => window.removeEventListener('keydown', shortcut)
    }
    stopListening?: () => void
    disconnectedCallback() {
      this.stopListening?.()
    }
  }
  customElements.define('site-search', SiteSearch)
</script>
