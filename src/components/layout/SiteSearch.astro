---
import '../../styles/search.css'
---

<site-search>
  <button
    class="search-trigger"
    type="button"
    disabled
    aria-label="Search"
    aria-keyshortcuts="Control+K"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </svg>
    <span class="search-label" aria-hidden="true">
      Search
    </span>
    <kbd class="search-shortcut" aria-hidden="true">
      Ctrl K
    </kbd>
  </button>
  <dialog aria-label="Search">
    <div class="search-panel">
      <div class="search-heading">
        <h2>Search</h2>
        <button class="search-close" type="button" aria-label="Close search">
          Close
        </button>
      </div>
      {import.meta.env.DEV ? (
        <p>Search is available in the production preview.</p>
      ) : (
        <>
          <p class="search-status" role="status" hidden>
            Loading search…
          </p>
          <div id="site-search-results" />
        </>
      )}
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>('.search-trigger')!
      const close = this.querySelector<HTMLButtonElement>('.search-close')!
      const dialog = this.querySelector('dialog')!
      const status = this.querySelector<HTMLElement>('.search-status')
      let initialising: Promise<void> | undefined
      if (/(Mac|iPhone|iPad|iPod)/i.test(navigator.platform)) {
        this.querySelector('kbd')!.textContent = '⌘ K'
        trigger.setAttribute('aria-keyshortcuts', 'Meta+K')
      }
      trigger.disabled = false
      const focusInput = () => {
        if (dialog.open) this.querySelector<HTMLInputElement>('input')?.focus()
      }
      const initialise = () => {
        if (import.meta.env.DEV) return Promise.resolve()
        if (initialising) return initialising
        status!.hidden = false
        status!.textContent = 'Loading search…'
        initialising = (async () => {
          // @ts-expect-error Pagefind's default UI package does not declare types.
          const { PagefindUI } = await import('@pagefind/default-ui')
          new PagefindUI({
            element: '#site-search-results',
            bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`,
            baseUrl: import.meta.env.BASE_URL,
            showImages: false,
            showSubResults: true,
            translations: { placeholder: 'Search the site' },
          })
          status!.hidden = true
        })().catch(() => {
          initialising = undefined
          status!.textContent =
            'Search is unavailable. Close and reopen to try again.'
        })
        return initialising
      }
      const open = () => {
        // Search and the mobile menu should never compete for keyboard focus.
        document
          .querySelectorAll<HTMLElement>('[popover]:popover-open')
          .forEach((menu) => menu.hidePopover())
        dialog.showModal()
        requestAnimationFrame(focusInput)
        initialise().then(focusInput)
      }
      trigger.addEventListener('click', open)
      close.addEventListener('click', () => dialog.close())
      dialog.addEventListener('click', (event) => {
        const link = (event.target as Element).closest('a[href]')
        if (event.target === dialog || link) dialog.close()
      })
      dialog.addEventListener('close', () =>
        trigger.focus({ preventScroll: true }),
      )
      const shortcut = (event: KeyboardEvent) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          !event.altKey &&
          event.key.toLowerCase() === 'k'
        ) {
          event.preventDefault()
          if (dialog.open) dialog.close()
          else open()
        }
      }
      window.addEventListener('keydown', shortcut)
      this.stopListening = () => window.removeEventListener('keydown', shortcut)
    }
    stopListening?: () => void
    disconnectedCallback() {
      this.stopListening?.()
    }
  }
  customElements.define('site-search', SiteSearch)
</script>
