---
interface Props {
  target: string
  label: string
  fixed?: boolean
}
const { target, label, fixed = false } = Astro.props
---

<button
  class:list={['site-menu-button', { 'site-menu-button-fixed': fixed }]}
  type="button"
  popovertarget={target}
  aria-label={label}
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path class="menu-open" d="M3 6h18M3 12h18M3 18h18"></path>
    <path class="menu-close" d="M5 5l14 14M19 5L5 19"></path>
  </svg>
</button>
