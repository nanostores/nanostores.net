---
import Brand from './Brand.astro'
import SiteNav from './SiteNav.astro'
import SiteSearch from './SiteSearch.astro'
interface Props {
  // Docs: the content draws its own strip of paper inside Starlight's header.
  sheet?: boolean
  search?: boolean
}
const { sheet = false, search = false } = Astro.props
---

<div class:list={['site-header-inner', { 'site-header-sheet': sheet }]}>
  <Brand />
  <div class="site-header-search">{search && <SiteSearch />}</div>
  <div class="site-header-actions">
    <SiteNav />
  </div>
</div>
