---
import BaseLayout from '../layouts/BaseLayout.astro'
import CodeWindow from '../components/primitives/CodeWindow.astro'
import SiteSidebar from '../components/layout/SiteSidebar.astro'
import { getEcosystemGroups } from '../lib/ecosystem'

const groups = await getEcosystemGroups()
---

<BaseLayout
  title="Ecosystem | Nano Stores"
  description="Connect your framework, add persistence, data fetching, routing or i18n when the task shows up, and inspect every store in Redux DevTools."
>
  <div class="leaf ecosystem-leaf">
    <aside class="ecosystem-index" data-pagefind-ignore="all">
      <details class="index-panel" data-sidebar-pane open>
        <summary class="index-toggle">Navigation</summary>
        <nav aria-label="Sidebar navigation">
          <SiteSidebar ecosystemGroups={groups} />
        </nav>
      </details>
    </aside>
    <div class="ecosystem-content">
      {groups.map((group) => (
        <section
          class:list={['group', group.tone, { compact: group.compact }]}
          id={group.id}
        >
          <div class="container">
            <header class="group-head">
              {group.id === 'frameworks' ? (
                <h1>{group.title}</h1>
              ) : (
                <h2>{group.title}</h2>
              )}
              {group.lead && <p class="lead">{group.lead}</p>}
              {group.link && <a href={group.link.href}>{group.link.text}</a>}
            </header>
            {[group.rows, group.more].map(
              (rows, i) =>
                rows.length > 0 && (
                  <>
                    {i === 1 && (
                      <p class="mono subhead" id="more-packages">
                        More packages
                      </p>
                    )}
                    <div class:list={['rows', { more: i === 1 }]}>
                      {rows.map((row) => (
                        <article
                          class:list={['row', { featured: row.featured }]}
                          id={row.id}
                        >
                          <div class="row-head">
                            <div class="pain">
                              <h3>{row.title}</h3>
                              {row.read && <code class="read">{row.read}</code>}
                              {row.text && <p>{row.text}</p>}
                            </div>
                            <div class="ref">
                              <a
                                class="module"
                                href={row.module.href}
                                data-package={row.module.name}
                              >
                                {row.module.name}
                                {row.module.href.startsWith('http')
                                  ? ' ↗'
                                  : ' →'}
                              </a>
                              <span class="mono note">{row.module.note}</span>
                              {row.alternative && (
                                <span class="alternative">
                                  {row.alternativeLead}:{' '}
                                  <a
                                    href={row.alternative.href}
                                    data-package={row.alternative.name}
                                  >
                                    {row.alternative.name} ↗
                                  </a>{' '}
                                  <span class="mono note">
                                    {row.alternative.note}
                                  </span>
                                </span>
                              )}
                            </div>
                          </div>
                          {row.points && (
                            <ul class="points">
                              {row.points.map((point) => (
                                <li>{point}</li>
                              ))}
                            </ul>
                          )}
                          {row.snippets && (
                            <div class="row-code">
                              {row.snippets.map((s) => (
                                <CodeWindow
                                  file={s.file}
                                  caption={s.caption}
                                  store
                                />
                              ))}
                            </div>
                          )}
                          {(row.boundary || row.usedIn.length > 0) && (
                            <div class="row-foot">
                              {row.boundary && <p>{row.boundary}</p>}
                              {row.usedIn.map((s) => (
                                <a href={`/for/${s.id}/`}>
                                  Used in: {s.data.toc} →
                                </a>
                              ))}
                            </div>
                          )}
                        </article>
                      ))}
                    </div>
                  </>
                ),
            )}
            {group.id === 'capabilities' && (
              <a
                class="full-list"
                href="https://github.com/nanostores/nanostores/discussions"
              >
                Missing a package? Tell us →
              </a>
            )}
            {group.boundary && (
              <p class="boundary">
                <span>
                  {group.boundary.text} <b>{group.boundary.strong}</b>
                </span>
              </p>
            )}
          </div>
        </section>
      ))}

      <section class="next container">
        <a href="/docs/getting-started/">
          <strong>Getting started →</strong>
          <span>Your first store and component in a few minutes.</span>
        </a>
        <a href="/">
          <strong>Find your situation →</strong>
          <span>Islands, Context, live data, several frameworks.</span>
        </a>
      </section>
    </div>
  </div>

  <script>
    import { track } from '../lib/analytics'
    document
      .querySelectorAll<HTMLAnchorElement>('[data-package]')
      .forEach((link) =>
        link.addEventListener('click', () =>
          track('package_click', {
            package: link.dataset.package,
            target:
              link.origin === location.origin
                ? link.pathname + link.search + link.hash
                : link.href,
            placement: 'ecosystem-package',
          }),
        ),
      )

    const panel = document.querySelector<HTMLDetailsElement>('.index-panel')!
    const desktop = matchMedia('(min-width: 50rem)')
    const adaptIndex = () => {
      panel.open = desktop.matches
    }
    adaptIndex()
    desktop.addEventListener('change', adaptIndex)
  </script>
</BaseLayout>
<style>
  .ecosystem-leaf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .ecosystem-content {
    min-width: 0;
    container: ecosystem-content / inline-size;
  }
  .ecosystem-index {
    min-width: 0;
    border-bottom: 1px solid var(--line);
  }
  .index-panel {
    max-height: 60svh;
    overflow-y: auto;
    padding: var(--space-4) var(--site-header-sheet-gutter);
  }
  .index-panel > summary {
    color: var(--text-2);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
  }
  .index-panel nav {
    margin-top: var(--space-4);
  }
  @media (width >= 50rem) {
    .ecosystem-leaf {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
    .ecosystem-index {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .index-panel {
      position: sticky;
      top: var(--space-5);
      max-height: calc(100svh - 2 * var(--space-5));
      scrollbar-gutter: stable;
    }
    .index-panel > summary {
      display: none;
    }
    .index-panel nav {
      margin-top: 0;
    }
  }
  @media print {
    .ecosystem-leaf {
      display: block;
    }
    .ecosystem-index {
      display: none;
    }
  }
  .ecosystem-leaf .container {
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--site-header-sheet-gutter);
  }
  .group:first-child {
    border-top: 0;
  }
  h1,
  h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 680;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }
  h3 {
    margin: 0;
    font-size: clamp(21px, 1.8vw, 26px);
    font-weight: 680;
    line-height: 1.2;
  }
  p {
    line-height: 1.6;
  }

  .group {
    padding-block: 32px 24px;
    border-top: 1px solid var(--line);
    scroll-margin-top: var(--header-h);
  }
  .group.ink {
    border-top: 0;
  }
  .group-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 880px;
    margin-bottom: 36px;
  }

  .compact .group-head {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    max-width: none;
    gap: 12px 24px;
  }
  .compact .group-head > a {
    margin-left: auto;
    text-align: right;
  }

  .rows {
    border-bottom: 2px solid var(--text);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: 28px;
    border-top: 2px solid var(--text);
    scroll-margin-top: var(--header-h);
  }
  .row-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px 48px;
  }
  .pain {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 720px;
  }
  .pain p {
    margin: 0;
    color: var(--text-2);
  }
  .ref {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }
  .module {
    font:
      400 17px 'Fragment Mono',
      monospace;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .note {
    color: var(--text-3);
    font-size: 11px;
  }
  .alternative {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 14px;
  }
  .alternative a {
    font-family: 'Fragment Mono', monospace;
    font-size: 13px;
  }
  .read {
    font:
      400 14px 'Fragment Mono',
      monospace;
    color: var(--text-2);
  }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .points li {
    padding: 5px 10px;
    border-radius: var(--radius-control);
    background: var(--control);
    color: var(--text-2);
  }
  .row-code {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 14px;
    max-width: 880px;
  }
  .featured .row-code {
    max-width: none;
  }
  .row-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    font-size: 15px;
  }
  .row-foot p {
    margin: 0;
    color: var(--text-3);
  }
  .row-foot a {
    font-weight: 500;
  }
  .featured h3 {
    font-size: clamp(26px, 2.4vw, 34px);
  }

  .compact .row,
  .more .row {
    gap: 6px;
    padding-block: 10px;
    border-top-width: 1px;
    border-color: var(--line);
  }
  .compact .row:first-child,
  .more .row:first-child {
    border-top: 2px solid var(--text);
  }
  .compact h3,
  .more h3 {
    font-size: 18px;
  }
  .compact .pain {
    flex-direction: row;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    min-width: 0;
  }
  .compact .pain > * {
    flex-shrink: 0;
  }
  .compact .row-head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .compact .ref {
    margin-left: auto;
  }
  .compact .read {
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  .compact .row-head,
  .more .row-head {
    align-items: center;
  }
  .compact .ref,
  .more .ref {
    flex-flow: row wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 2px 12px;
  }
  .compact .alternative,
  .more .alternative {
    flex-basis: 100%;
    margin-top: 0;
    font-size: 13px;
  }
  .alternative .note {
    margin-left: 4px;
  }
  .compact .module,
  .more .module {
    font-size: 15px;
  }
  .compact .ref > .note,
  .more .ref > .note {
    min-width: 72px;
  }
  .subhead {
    scroll-margin-top: var(--header-h);
    margin: 40px 0 12px;
    color: var(--text-3);
  }
  .full-list {
    display: inline-block;
    margin-top: 20px;
    font-weight: 500;
  }
  .ink .rows {
    border-bottom: 0;
  }
  .ink .boundary {
    padding-top: 20px;
    border-top: 2px solid var(--text);
  }

  .next {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding-block: 56px 96px;
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border-radius: var(--radius-card);
    background: var(--tint);
    text-decoration: none;
  }
  .next a:hover {
    background: var(--tint-2);
  }
  .next strong {
    font-size: 18px;
    font-weight: 600;
  }
  .next span {
    color: var(--text-2);
    font-size: 15px;
  }

  @container ecosystem-content (width <= 40rem) {
    .group {
      padding-block: 32px 24px;
    }
    .row-head {
      grid-template-columns: 1fr;
    }
    .ref,
    .compact .ref,
    .more .ref {
      align-items: flex-start;
      justify-content: flex-start;
      text-align: left;
    }
    .compact .ref,
    .more .ref {
      align-items: baseline;
    }
    .module {
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .next {
      grid-template-columns: 1fr;
    }
  }
</style>
