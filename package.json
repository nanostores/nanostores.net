{
  "name": "nanostores-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "pnpm run dev --host 0.0.0.0 --port 4321",
    "dev": "node scripts/fetch-upstream.mjs && node --import ./scripts/windows-sandbox.mjs ./node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/fetch-upstream.mjs && node --import ./scripts/windows-sandbox.mjs ./node_modules/astro/bin/astro.mjs build",
    "check": "pnpm run build && node scripts/check-build.mjs",
    "check:types": "node scripts/fetch-upstream.mjs && node --import ./scripts/windows-sandbox.mjs ./node_modules/astro/bin/astro.mjs check",
    "check:snippets": "vue-tsc -p src/snippets/tsconfig.json",
    "check:size": "size-limit",
    "test": "node scripts/fetch-upstream.mjs && pnpm run --parallel --no-bail --aggregate-output \"/^test:/\"",
    "test:unit": "node scripts/fetch-upstream.mjs && node --import ./scripts/windows-sandbox.mjs ./node_modules/vitest/vitest.mjs run",
    "test:snippets": "node --import ./scripts/windows-sandbox.mjs ./node_modules/vitest/vitest.mjs run --config vitest.snippets.config.ts",
    "test:snippet-types": "pnpm run check:snippets",
    "test:astro": "pnpm run check:types && pnpm run check && pnpm run check:size",
    "test:format": "pnpm run format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "node --import ./scripts/windows-sandbox.mjs ./node_modules/astro/bin/astro.mjs preview",
    "fetch:upstream": "node scripts/fetch-upstream.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "sync:downloads": "node scripts/sync-downloads.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "astro": "node --import ./scripts/windows-sandbox.mjs ./node_modules/astro/bin/astro.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.8",
    "nanostores": "^1.5.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "0.5.1",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/core": "^0.44.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/jacquard-12": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@nanostores/deepmap": "^1.0.0",
    "@nanostores/i18n": "^1.3.3",
    "@nanostores/logger": "^1.1.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/query": "^0.3.4",
    "@nanostores/react": "^2.0.1",
    "@nanostores/router": "^2.0.0",
    "@nanostores/vue": "^1.1.0",
    "@pagefind/default-ui": "^1.5.2",
    "@size-limit/file": "^14.2.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "nanostores-devtools": "^0.2.0",
    "oxfmt": "^0.73.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "size-limit": "^14.2.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  },
  "size-limit": [
    {
      "name": "Site JS",
      "path": [
        "dist/_astro/*.js",
        "!dist/_astro/ui-core.*.js"
      ],
      "brotli": false,
      "limit": "14 kB"
    },
    {
      "name": "Search JS",
      "path": [
        "dist/_astro/ui-core.*.js",
        "dist/pagefind/pagefind.js",
        "dist/pagefind/pagefind-worker.js"
      ],
      "brotli": false,
      "limit": "181 kB"
    }
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
